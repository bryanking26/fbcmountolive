---
import Layout from "../layouts/Layout.astro";

// TODO: Update these placeholders before launch
const YOUTUBE_URL  = "https://www.youtube.com/@firstbaptistmountolive9502";
const GIVING_URL   = "https://give.example.com";
const MAPS_URL     = "https://maps.google.com/?q=First+Baptist+Church+Mount+Olive+NC";
const PHONE        = "tel:+19195550000";
const EMAIL        = "mailto:office@fbcmountolive.org";
const ADDRESS_LINE1 = "300 North Chestnut Street";        // TODO: confirm
const ADDRESS_LINE2 = "Mount Olive, North Carolina 28365";       // TODO: confirm
const SERVICE_TIME  = "10:45 AM";                    // TODO: confirm
---

<Layout>
  <!-- ── Navigation ──────────────────────────────────────────────── -->
  <header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="#hero" class="flex items-center gap-3">
        <img
          src="/logo.png"
          alt="First Baptist Mount Olive"
          class="h-10 w-auto"
          style="filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.55));"
        />
      </a>
      <ul class="flex items-center gap-6 text-sm font-medium text-white/90">
        <li><a href="#welcome"      class="hover:text-white transition-colors hidden md:block">About</a></li>
        <li><a href="#service-times" class="hover:text-white transition-colors hidden md:block">Worship</a></li>
        <li><a href="#connect"      class="hover:text-white transition-colors hidden md:block">Connect</a></li>
        <li>
          <a href="#contact" class="px-4 py-2 border border-white/60 rounded text-white text-sm hover:bg-white/10 transition-colors">
            Visit Us
          </a>
        </li>
      </ul>
    </nav>
  </header>

  <!-- ── Hero ────────────────────────────────────────────────────── -->
  <section
    id="hero"
    class="relative min-h-screen flex flex-col items-center justify-center text-center overflow-hidden"
  >
    <img src="/sanctuary.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <!-- Vignette: lighter at center where text sits, darker at edges for cinematic depth -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 85% 75% at center, rgba(11, 26, 15, 0.40) 0%, rgba(11, 26, 15, 0.85) 100%);"></div>
    <!-- Top fade for nav contrast -->
    <div class="absolute inset-x-0 top-0 h-40" style="background: linear-gradient(to bottom, rgba(11, 26, 15, 0.75) 0%, transparent 100%);"></div>

    <div class="relative z-10 px-6 max-w-4xl mx-auto">
      <p class="fade-in text-sm font-medium tracking-[0.3em] uppercase mb-6" style="color: #d4b46a;">
        Founded 1878 &nbsp;·&nbsp; Mount Olive, North Carolina
      </p>
      <h1 class="fade-in fade-delay-1 font-display text-white text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight mb-6">
        First Baptist Church
        <span class="block italic font-normal text-4xl sm:text-5xl lg:text-6xl mt-2" style="color: #f8f5f0;">
          of Mount Olive
        </span>
      </h1>
      <p class="fade-in fade-delay-2 text-white/80 text-lg sm:text-xl max-w-xl mx-auto leading-relaxed mb-10">
        A welcoming family rooted in faith, gathering in a sanctuary that has
        proclaimed the Gospel for over a century. You are warmly invited.
      </p>
      <div class="fade-in fade-delay-3 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#service-times"
          class="px-8 py-4 text-white font-medium rounded transition-all text-base shadow-lg"
          style="background-color: #1f5c2e; border: 1px solid rgba(212, 180, 106, 0.4);"
          onmouseover="this.style.backgroundColor='#2d713e'"
          onmouseout="this.style.backgroundColor='#1f5c2e'"
        >
          Plan a Visit
        </a>
        <a
          href={YOUTUBE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border border-white/50 hover:bg-white/10 text-white font-medium rounded transition-colors text-base"
        >
          Watch Online
        </a>
      </div>
    </div>

    <!-- Refined scroll indicator: thin animated hairline + microtext -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
      <span class="text-xs font-medium tracking-[0.35em] uppercase" style="color: rgba(212, 180, 106, 0.75);">
        Explore
      </span>
      <div class="relative h-12 w-px overflow-hidden" style="background: rgba(255, 255, 255, 0.15);">
        <div
          class="absolute top-0 left-0 w-full"
          style="height: 40%; background: linear-gradient(to bottom, transparent, #d4b46a); animation: scroll-line 2.4s ease-in-out infinite;"
        ></div>
      </div>
    </div>
    <style>
      @keyframes scroll-line {
        0%   { transform: translateY(-100%); opacity: 0; }
        25%  { opacity: 1; }
        100% { transform: translateY(250%); opacity: 0; }
      }
    </style>
  </section>

  <!-- ── Welcome ──────────────────────────────────────────────────── -->
  <section id="welcome" class="py-24 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="text-center">
        <!-- Small gold ornament above heading -->
        <div class="fade-in flex items-center justify-center gap-4 mb-6">
          <div class="w-8 border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M8 1.5v13M1.5 8h13" stroke="#c5a028" stroke-width="1.25" stroke-linecap="round"/>
          </svg>
          <div class="w-8 border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
        </div>
        <p class="fade-in text-sm font-medium tracking-[0.25em] uppercase mb-4" style="color: #a88218;">Welcome Home</p>
        <h2 class="fade-in font-display text-green-950 text-4xl sm:text-5xl font-bold mb-10 leading-snug">
          Grace, Community,<br />and a Century of Song
        </h2>
      </div>

      <!-- First paragraph with drop cap -->
      <p class="fade-in drop-cap text-green-900/75 text-lg leading-relaxed mb-10">
        Nestled in the heart of Mount Olive, our congregation has gathered in this
        historic sanctuary since 1878 — and through every generation, the same call
        to worship has gone out: come, and be welcomed.
      </p>

      <!-- Featured pull-quote -->
      <figure class="fade-in my-12 text-center">
        <div class="flex items-center justify-center gap-5 mb-6">
          <div class="flex-1 max-w-[80px] border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
          <span style="color: #c5a028;" class="text-xs">✦</span>
          <div class="flex-1 max-w-[80px] border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
        </div>
        <blockquote class="font-display italic text-2xl sm:text-3xl text-green-900 leading-snug max-w-2xl mx-auto">
          The same pipe organ that has led generations in worship still calls us together each Sunday morning.
        </blockquote>
        <div class="flex items-center justify-center gap-5 mt-6">
          <div class="flex-1 max-w-[80px] border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
          <span style="color: #c5a028;" class="text-xs">✦</span>
          <div class="flex-1 max-w-[80px] border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
        </div>
      </figure>

      <p class="fade-in text-green-900/75 text-lg leading-relaxed text-center">
        Whether you are a lifelong Baptist or simply curious, there is a place for
        you here. We invite you to come as you are — and experience the warmth of a
        community built on grace.
      </p>

    </div>
  </section>

  <!-- ── Meet Our Pastor & Staff ──────────────────────────────────── -->
  <section id="pastor" class="py-24 px-6 bg-cream bg-paper">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 lg:gap-20">

      <!-- LEFT COLUMN: Senior Pastor -->
      <div>
        <div class="text-center mb-10">
          <!-- Gold ornament -->
          <div class="fade-in flex items-center justify-center gap-4 mb-6">
            <div class="w-8 border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 1.5v13M1.5 8h13" stroke="#c5a028" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <div class="w-8 border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
          </div>
          <p class="fade-in text-sm font-medium tracking-[0.25em] uppercase mb-4" style="color: #a88218;">Meet Our Pastor</p>
          <h2 class="fade-in font-display text-green-950 text-3xl sm:text-4xl font-bold leading-snug">
            Dr. Timothy Lipp
          </h2>
          <p class="fade-in font-display italic text-lg mt-3" style="color: #1f5c2e;">Senior Pastor</p>
        </div>

        <img
          src="/pastor.jpg"
          alt="Dr. Timothy Lipp, Senior Pastor"
          class="fade-in w-48 h-48 rounded-full object-cover mx-auto mb-10 shadow-xl ring-1 ring-green-200"
        />

        <div class="space-y-5 text-green-900/75 text-base leading-relaxed">
          <p class="fade-in">
            Dr. Lipp joined First Baptist Mount Olive as senior pastor in May 2026,
            bringing more than 25 years of pastoral ministry to the congregation. A native
            of the Raleigh area, he grew up at First Baptist Church, Cary, where his father
            served on the pastoral staff.
          </p>
          <p class="fade-in">
            He answered the call to vocational ministry during his years at the University
            of North Carolina at Wilmington and went on to earn both his Master of Divinity
            (2004) and Doctor of Ministry (2015) at Campbell Divinity School. Ordained at
            First Baptist Church of Fayetteville, he has served churches across North
            Carolina and Virginia — most recently Rosewood First Baptist in Goldsboro,
            where he pastored from 2023 until his coming to Mount Olive.
          </p>
          <p class="fade-in">
            Dr. Lipp and his wife Beth — a behavioral therapist who works with children on
            the autism spectrum — have been married for 24 years. Their daughter Sophie
            (b. 2009) plays soccer and cheers for Rosewood High School; their son Cohen
            (b. 2018) loves Legos and is learning to play soccer. The family enjoys
            summers at the Carolina coast and ski trips to the North Carolina mountains
            in winter.
          </p>

          <!-- Closing invitation in italic -->
          <p class="fade-in font-display italic text-center text-lg pt-4" style="color: #1f5c2e;">
            "Come check us out on Sunday mornings, Wednesday evenings, and any of our
            ministries for every age and stage of life."
          </p>
        </div>
      </div>

      <!-- RIGHT COLUMN: Support Staff -->
      <div>
        <div class="text-center mb-10">
          <!-- Gold ornament -->
          <div class="fade-in flex items-center justify-center gap-4 mb-6">
            <div class="w-8 border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 1.5v13M1.5 8h13" stroke="#c5a028" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <div class="w-8 border-t" style="border-color: rgba(197, 160, 40, 0.5);"></div>
          </div>
          <p class="fade-in text-sm font-medium tracking-[0.25em] uppercase mb-4" style="color: #a88218;">Ministry Team</p>
          <h2 class="fade-in font-display text-green-950 text-3xl sm:text-4xl font-bold leading-snug">
            Serving Side by Side
          </h2>
          <p class="fade-in font-display italic text-lg mt-3" style="color: #1f5c2e;">Support Staff</p>
        </div>

        <!-- Staff cards -->
        <div class="space-y-8">

          <!-- Music Director -->
          <div class="fade-in flex items-start gap-5 bg-white/60 rounded-lg p-6 border border-green-100 shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
            <img
              src="/musicdirector.jpg"
              alt="Janet Rose, Music Director"
              class="shrink-0 w-30 h-30 rounded-full object-cover ring-1 ring-green-200"
            />
            <div class="flex-1 pt-1">
              <p class="text-xs font-medium tracking-[0.2em] uppercase mb-1" style="color: #a88218;">Music Director</p>
              <h3 class="font-display text-green-950 text-xl font-bold mb-2">Janet Rose</h3>
              <p class="text-green-900/70 text-sm leading-relaxed">
                Leads our traditional worship through the historic pipe organ, choir, and
                congregational hymn singing. Coordinates seasonal music programs and special
                services throughout the year.
              </p>
            </div>
          </div>

          <!-- Youth Director -->
          <div class="fade-in fade-delay-1 flex items-start gap-5 bg-white/60 rounded-lg p-6 border border-green-100 shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
            <img
              src="/youthdirector.jpg"
              alt="Beth Rose, Youth Director"
              class="shrink-0 w-30 h-30 rounded-full object-cover ring-1 ring-green-200"
            />
            <div class="flex-1 pt-1">
              <p class="text-xs font-medium tracking-[0.2em] uppercase mb-1" style="color: #a88218;">Youth Director</p>
              <h3 class="font-display text-green-950 text-xl font-bold mb-2">Beth Rose</h3>
              <p class="text-green-900/70 text-sm leading-relaxed">
                A native of Mount Olive and lifelong member of First Baptist, Beth teaches
                7th grade English Language Arts at Mount Olive Middle School — where she was
                named the NC Center for the Advancement of Teaching's Beginning Teacher of
                the Year in 2023. She brings that same passion for guiding young people to
                her ministry with our youth.
              </p>
            </div>
          </div>

          <!-- Closing line to balance the column visually -->
          <p class="fade-in fade-delay-2 font-display italic text-center text-lg pt-4 px-4" style="color: #1f5c2e;">
            "Together with our pastor, our staff is here to walk with you in every season of life."
          </p>

        </div>
      </div>

    </div>
  </section>

  <!-- Divider with cross ornament — separates About (pastor/staff) from Worship -->
  <div class="bg-cream bg-paper">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-center gap-5">
        <div class="flex-1 max-w-[160px] border-t" style="border-color: rgba(197, 160, 40, 0.4);"></div>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 1.5v13M1.5 8h13" stroke="#c5a028" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        <div class="flex-1 max-w-[160px] border-t" style="border-color: rgba(197, 160, 40, 0.4);"></div>
      </div>
    </div>
  </div>

  <!-- ── Service Times ─────────────────────────────────────────────── -->
  <section id="service-times" class="py-24 px-6 bg-cream bg-paper">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <p class="fade-in text-sm font-medium tracking-[0.25em] uppercase mb-4" style="color: #a88218;">Join Us</p>
        <h2 class="fade-in font-display text-green-950 text-4xl sm:text-5xl font-bold leading-snug">
          Sunday Worship
        </h2>
      </div>

      <div class="grid sm:grid-cols-5 gap-6">

        <!-- Monumental Time card — wider, centerpiece -->
        <div class="fade-in sm:col-span-3 text-center bg-white rounded-lg px-10 py-14 shadow-sm border border-green-100 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <p class="text-green-900/60 text-xs font-medium tracking-[0.3em] uppercase mb-6">Morning Worship</p>

          <!-- Monumental time display -->
          <div class="flex items-baseline justify-center gap-2 mb-2">
            {SERVICE_TIME.split(" ").map((part, i) => (
              i === 0 ? (
                <span class="font-display text-green-950 text-7xl sm:text-8xl font-bold leading-none tracking-tight">{part}</span>
              ) : (
                <span class="font-display text-green-800 text-3xl sm:text-4xl font-normal italic">{part}</span>
              )
            ))}
          </div>

          <!-- Hairline gold accent under time -->
          <div class="flex items-center justify-center gap-3 my-5">
            <div class="w-12 border-t" style="border-color: rgba(197, 160, 40, 0.6);"></div>
            <span style="color: #c5a028;" class="text-xs">✦</span>
            <div class="w-12 border-t" style="border-color: rgba(197, 160, 40, 0.6);"></div>
          </div>

          <p class="font-display italic text-green-900 text-lg">Every Sunday</p>
        </div>

        <!-- Location card -->
        <div class="fade-in fade-delay-1 sm:col-span-2 text-center rounded-lg px-8 py-14 shadow-sm text-white transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="background-color: #1f5c2e;">
          <div class="w-14 h-14 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: #d4b46a;">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <p class="text-xs font-medium tracking-[0.3em] uppercase mb-3" style="color: #d4b46a;">Location</p>
          <p class="font-display text-white text-xl font-semibold leading-snug">{ADDRESS_LINE1}</p>
          <p class="text-sm mt-1 text-white/70">{ADDRESS_LINE2}</p>
          <a
            href={MAPS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-5 text-sm hover:text-white transition-colors underline underline-offset-2"
            style="color: #d4b46a;"
          >
            Get Directions →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Scripture Band ───────────────────────────────────────────── -->
  <section class="py-24 px-6 text-center" style="background-color: #0b1a0f;">
    <div class="max-w-3xl mx-auto">
      <!-- Gold ornament rule above -->
      <div class="fade-in flex items-center justify-center gap-5 mb-10">
        <div class="flex-1 max-w-[140px] border-t" style="border-color: rgba(212, 180, 106, 0.4);"></div>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 1.5v13M1.5 8h13" stroke="#d4b46a" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        <div class="flex-1 max-w-[140px] border-t" style="border-color: rgba(212, 180, 106, 0.4);"></div>
      </div>

      <blockquote class="fade-in font-display italic text-white text-2xl sm:text-3xl lg:text-4xl leading-relaxed">
        "I was glad when they said unto me,<br />
        Let us go into the house of the <span style="color: #d4b46a;">L<span class="text-2xl sm:text-3xl">ORD</span></span>."
      </blockquote>

      <p class="fade-in text-sm font-medium tracking-[0.35em] uppercase mt-8" style="color: #d4b46a;">
        Psalm 122 : 1
      </p>

      <!-- Gold ornament rule below -->
      <div class="fade-in flex items-center justify-center gap-5 mt-10">
        <div class="flex-1 max-w-[140px] border-t" style="border-color: rgba(212, 180, 106, 0.4);"></div>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 1.5v13M1.5 8h13" stroke="#d4b46a" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        <div class="flex-1 max-w-[140px] border-t" style="border-color: rgba(212, 180, 106, 0.4);"></div>
      </div>
    </div>
  </section>

  <!-- ── Connect ──────────────────────────────────────────────────── -->
  <section id="connect" class="py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <p class="fade-in text-sm font-medium tracking-[0.25em] uppercase mb-4" style="color: #a88218;">Get Involved</p>
        <h2 class="fade-in font-display text-green-950 text-4xl sm:text-5xl font-bold leading-snug">
          Grow With Us
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">

        <!-- Sermons → YouTube -->
        <a
          href={YOUTUBE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="fade-in group relative overflow-hidden rounded-xl p-10 flex flex-col justify-between min-h-64 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
          style="background-color: #0b1a0f;"
          onmouseover="this.style.backgroundColor='#1f5c2e'"
          onmouseout="this.style.backgroundColor='#0b1a0f'"
        >
          <div>
            <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center mb-6 group-hover:bg-white/20 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: #4db848;">
                <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
              </svg>
            </div>
            <h3 class="font-display text-white text-2xl font-bold mb-3">Watch Sermons</h3>
            <p class="text-white/60 text-sm leading-relaxed">
              Catch up on recent messages or explore our sermon library on YouTube.
            </p>
          </div>
          <span class="text-sm font-medium mt-8 transition-colors" style="color: #4db848;">
            View on YouTube →
          </span>
        </a>

        <!-- Give -->
        <a
          href={GIVING_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="fade-in fade-delay-1 group relative overflow-hidden rounded-xl bg-parchment border border-green-200 p-10 flex flex-col justify-between min-h-64 hover:border-green-400 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <div>
            <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mb-6 group-hover:bg-green-200 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-green-700">
                <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
              </svg>
            </div>
            <h3 class="font-display text-green-950 text-2xl font-bold mb-3">Give Online</h3>
            <p class="text-green-900/60 text-sm leading-relaxed">
              Support the ministry of First Baptist Church with a gift. Your generosity makes a difference.
            </p>
          </div>
          <span class="text-green-700 text-sm font-medium mt-8 group-hover:text-green-600 transition-colors">
            Give Now →
          </span>
        </a>

        <!-- Newsletter — full width -->
        <a
          href="/newsletter-may-june-2026.pdf"
          download
          class="fade-in fade-delay-2 group sm:col-span-2 relative overflow-hidden rounded-xl p-10 flex flex-col sm:flex-row items-center gap-8 min-h-64 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
          style="background-color: #1f5c2e;"
          onmouseover="this.style.backgroundColor='#2d713e'"
          onmouseout="this.style.backgroundColor='#1f5c2e'"
        >
          <div class="shrink-0 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: #d4b46a;">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <div class="flex-1 text-center sm:text-left">
            <p class="text-xs font-medium tracking-widest uppercase mb-2" style="color: #d4b46a;">The Crier</p>
            <h3 class="font-display text-white text-2xl font-bold mb-3">Church Newsletter</h3>
            <p class="text-white/60 text-sm leading-relaxed">
              Updates, announcements, and encouragement from our congregation.
            </p>
          </div>
          <span class="shrink-0 text-sm font-medium transition-colors" style="color: #d4b46a;">
            Download PDF →
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── Contact ──────────────────────────────────────────────────── -->
  <section id="contact" class="py-24 px-6 text-white" style="background-color: #1f5c2e;">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Gold ornament above eyebrow -->
      <div class="fade-in flex items-center justify-center gap-4 mb-6">
        <div class="w-8 border-t" style="border-color: rgba(212, 180, 106, 0.5);"></div>
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 1.5v13M1.5 8h13" stroke="#d4b46a" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        <div class="w-8 border-t" style="border-color: rgba(212, 180, 106, 0.5);"></div>
      </div>
      <p class="fade-in text-sm font-medium tracking-[0.25em] uppercase mb-4" style="color: #d4b46a;">We'd Love to Meet You</p>
      <h2 class="fade-in font-display text-white text-4xl sm:text-5xl font-bold mb-8 leading-snug">
        Come As You Are
      </h2>
      <p class="fade-in text-white/70 text-lg leading-relaxed max-w-xl mx-auto mb-12">
        Our doors are open every Sunday morning. If you have questions or would like
        to know more before you visit, we'd love to hear from you.
      </p>
      <div class="fade-in flex flex-col sm:flex-row gap-4 justify-center flex-wrap">
        <a
          href={EMAIL}
          class="px-8 py-4 text-white font-medium rounded transition-all shadow-lg"
          style="background-color: #0b1a0f; border: 1px solid rgba(212, 180, 106, 0.4);"
          onmouseover="this.style.backgroundColor='#1a3a26'"
          onmouseout="this.style.backgroundColor='#0b1a0f'"
        >
          Send Us a Message
        </a>
        <a
          href={PHONE}
          class="px-8 py-4 border border-white/40 hover:bg-white/10 text-white font-medium rounded transition-colors"
        >
          Call the Office
        </a>
      </div>
    </div>
  </section>

  <!-- ── Footer ──────────────────────────────────────────────────── -->
  <footer class="border-t border-white/10 py-12 px-6" style="background-color: #0b1a0f;">
    <div class="max-w-6xl mx-auto text-center">
      <!-- Centered gold cross -->
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="w-12 border-t" style="border-color: rgba(212, 180, 106, 0.3);"></div>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 1.5v13M1.5 8h13" stroke="#d4b46a" stroke-width="1.25" stroke-linecap="round" stroke-opacity="0.7"/>
        </svg>
        <div class="w-12 border-t" style="border-color: rgba(212, 180, 106, 0.3);"></div>
      </div>

      <p class="font-display italic text-white/60 mb-2">First Baptist Church of Mount Olive</p>
      <p class="font-display italic text-xs tracking-[0.3em] uppercase mb-6" style="color: rgba(212, 180, 106, 0.6);">
        Soli Deo Gloria
      </p>

      <p class="text-white/30 text-xs">© {new Date().getFullYear()} · All rights reserved</p>
    </div>
  </footer>

  <!-- Nav becomes opaque when hero scrolls out of view -->
  <script>
    const header = document.getElementById("site-header");
    const hero   = document.getElementById("hero");

    const navObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          header?.classList.remove("shadow-lg");
          header?.style.setProperty("background-color", "transparent");
        } else {
          header?.classList.add("shadow-lg");
          header?.style.setProperty("background-color", "#1f5c2e");
        }
      },
      { threshold: 0.1 }
    );

    if (hero) navObserver.observe(hero);

    // Scroll-triggered fade-ins
    const fadeEls = document.querySelectorAll<HTMLElement>(".fade-in");
    const fadeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            fadeObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
    );

    fadeEls.forEach((el) => fadeObserver.observe(el));
  </script>
</Layout>
